{
  "name": "relay-peer-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "vite --host 127.0.0.1 --port 5178",
    "test": "node --test tests/*.test.mjs",
    "webhook:ingress": "node server/webhook-ingress.mjs",
    "webhook:status": "node --env-file=.env scripts/sandbox-webhook.mjs status",
    "webhook:test": "node --env-file=.env scripts/sandbox-webhook.mjs test",
    "start:hosted": "node hosted/server.mjs",
    "worker": "node hosted/worker.mjs",
    "test:hosted": "node --test tests/hosted*.test.mjs",
    "test:offline": "node --import ./tests/fixtures/offline-guard.mjs --test tests/*.test.mjs",
    "test:tracking": "node --import ./tests/fixtures/offline-guard.mjs --test tests/hosted-live.test.mjs",
    "deploy:export": "node scripts/export-deployment.mjs",
    "preview:tracking": "node hosted/tracking-preview.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@zkp2p/pay-sdk": "8.0.0",
    "@zkp2p/sdk": "0.14.10",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.57.11",
    "@zkp2p/pay-shared": "8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
